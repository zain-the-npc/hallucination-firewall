# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values.

# API Keys for LLM Providers
OPENAI_API_KEY=
GROQ_API_KEY=

# Hugging Face Configuration (Model and Token)
HF_TOKEN=
HUGGINGFACE_TOKEN=
MODEL_ID=distilbert-base-uncased

# Search & News APIs (RAG Sources)
SERPER_API_KEY=
NEWS_API_KEY=

# Supabase Auth/Database Connection
SUPABASE_URL=
SUPABASE_KEY=

# Security & Model Configuration
HALLUCINATION_THRESHOLD=0.35
FRONTEND_URL=http://localhost:3000
